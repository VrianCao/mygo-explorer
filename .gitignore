# Read-only MyGo source checkout (28 MB). Re-clone with:
#   git clone --depth 1 https://github.com/egoist/mygo.git reference/mygo
/reference/

# Throwaway environment probes (generated by prep/scripts/preflight.sh and env-prep)
/prep/probe-native/build/
/prep/probe-native/build-universal/
/prep/probe-native/build-web/
/prep/probe-native/.mygo/
/prep/probe-capture/build/
/prep/probe-capture/.mygo/

# Target app build outputs (go tool mygo build / dev)
/app/build/
/app/.mygo/
mygo_windows_*.syso

# Signing material and secrets — never commit these
*.p12
mygo-update.key

# Temporary evidence artifacts
docs/evidence/**/*.tmp

# OS noise
.DS_Store
